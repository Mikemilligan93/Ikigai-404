// Cloudflare Workers config. Having this file stops Wrangler's auto-detection
// (it mistook config.json for a Hugo site). No build step: the repo root is served as static assets.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ikigai-404",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  // Leaderboard storage: KV namespace "ikigai404-leaderboard" (created 2026-10-16).
  "kv_namespaces": [{ "binding": "LEADERBOARD", "id": "58e5bc80ffae48f1bda95181570fa2b9" }]
}
